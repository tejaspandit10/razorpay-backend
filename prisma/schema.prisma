generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

//////////////////////
// AGENTS
//////////////////////

model Agent {
  id              String   @id @default(uuid())

  name            String
  email           String   @unique
  phone           String
  aadhaarNumber   String   @unique

  addressFull     String
  addressCity     String
  addressState    String
  addressPincode  String
  occupation      String

  // 🔥 NEW FIELDS
  accountNumber   String?
  ifscCode        String?

  agentCode       String   @unique
  isActive        Boolean  @default(false)

  createdAt       DateTime @default(now())
  approvedAt      DateTime?

  payments        AgentPayment[]

  @@map("agents")
}

/////////////////////////
/////// USER
////////////////////////

model User {
  id                     String   @id @default(uuid())

  firstName              String
  middleName             String?
  lastName               String
  email                  String
  phone                  String
  aadhaar                String
  dob                    DateTime
  gender                 String
  address                String

  preferredSector        Json
  preferredJobType       String
  careerGoal             String
  skills                 String
  englishProficiency     String
  expectedSalary         Int
  preferredLocation      String
  hasPreviousExperience  Boolean

  education              Json?
  previousExperience     Json?

  // 🔥 Store full PDF in DB
  resume                 Bytes?
  resumeFileName         String?
  resumeMimeType         String?

  resumeUrl              String?

  paymentStatus          PaymentStatus @default(PENDING)

  createdAt              DateTime @default(now())

  payments               UserPayment[]

  @@map("users")
}

//////////////////////
// USER PAYMENTS
//////////////////////

model UserPayment {
  id                    String   @id @default(uuid())

  razorpayOrderId       String
  razorpayPaymentId     String
  amount                Int
  gst                   Int
  status                PaymentStatus

  userId                String
  user                  User   @relation(fields: [userId], references: [id])

  createdAt             DateTime @default(now())

  @@map("user_payments")
}

//////////////////////
// AGENT PAYMENTS
//////////////////////

model AgentPayment {
  id                    String   @id @default(uuid())

  razorpayOrderId       String
  razorpayPaymentId     String
  amount                Int
  gst                   Int
  status                PaymentStatus

  agentId               String
  agent                 Agent   @relation(fields: [agentId], references: [id])

  createdAt             DateTime @default(now())

  @@map("agent_payments")
}

//////////////////////
// ADMINS
//////////////////////

model Admin {
  id            String    @id @default(uuid())

  name          String
  email         String    @unique
  passwordHash  String
  role          AdminRole @default(ADMIN)

  createdAt     DateTime  @default(now())

  @@map("admins")
}